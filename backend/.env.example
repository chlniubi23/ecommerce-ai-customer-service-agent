# Backend runtime
APP_ENV=development
APP_DEBUG=false

# OpenAI compatible API
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash
# LLM 请求超时（秒）与 SDK 自动重试次数
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# Frontend
FRONTEND_URL=http://localhost:3000

# MySQL Business Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_password
MYSQL_DATABASE=ai_agent_commerce_demo
MYSQL_CHARSET=utf8mb4

# ========== RAG: Embedding ==========
# local = sentence-transformers + BAAI/bge-small-zh-v1.5 本地推理（默认）
# openai = OpenAI 兼容 Embedding API（需配置 EMBEDDING_API_KEY / EMBEDDING_BASE_URL）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=512

# ========== RAG: 向量数据库 (qdrant-client 本地模式) ==========
# 首选 ChromaDB 在本机 Windows 不可用（Rust 绑定崩溃），按开发方案回退 qdrant 本地模式（纯 Python）
# 相对 backend/ 的持久化目录
QDRANT_PERSIST_DIR=vector_store/qdrant
QDRANT_COLLECTION=knowledge

# ========== RAG: 知识切片（统一 rebuild 脚本 / API upload / Pipeline） ==========
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ========== RAG: 检索 ==========
# 真实 Embedding 的相关性下限（黄金问题校准后回填，预期 0.3~0.45 区间）
RETRIEVAL_MIN_SCORE=0.35
